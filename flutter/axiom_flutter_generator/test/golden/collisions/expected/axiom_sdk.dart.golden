/// An [AxiomQuery] over a streaming endpoint: one success state per frame.
AxiomQuery<T> _streamQuery<T>(
  String key,
  AxiomRuntime runtime,
  AxiomStreamResponse Function(Map<String, String> extra) open,
  T Function(Object?) decode,
) {
