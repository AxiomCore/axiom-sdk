/// Form validators for [SignupIn] built from the contract field
/// rules. Each has the `TextFormField.validator` signature.
abstract final class SignupInValidators {
  static String? age(String? value) {
    if (value == null || value.isEmpty) return 'Required';
    final number = num.tryParse(value.trim());
    if (number == null) return 'Must be a number';
    if (number % 1 != 0) return 'Must be a whole number';
    if (number < 13) return 'Must be at least 13';
    if (number > 130) return 'Must be at most 130';
    return null;
  }

  static String? code(String? value) {
    if (value == null || value.isEmpty) return 'Required';
    if (!RegExp('^[A-Z]{3}-[0-9]{2}\$').hasMatch(value)) {
      return 'Invalid format';
    }
    return null;
  }

  static String? email(String? value) {
    if (value == null || value.isEmpty) return 'Required';
    if (value.length > 120) return 'Must be at most 120 characters';
    if (!RegExp(r'^[^@\s]+@[^@\s]+\.[^@\s]+$').hasMatch(value)) {
      return 'Must be a valid email address';
    }
    return null;
  }

  static String? name(String? value) {
    if (value == null || value.isEmpty) return 'Required';
    if (value.length < 2) return 'Must be at least 2 characters';
    if (value.length > 40) return 'Must be at most 40 characters';
    return null;
  }

  static String? score(String? value) {
    if (value == null || value.isEmpty) return null;
    final number = num.tryParse(value.trim());
    if (number == null) return 'Must be a number';
    if (number < 0) return 'Must be at least 0';
    if (number > 1) return 'Must be at most 1';
    return null;
  }

  /// All validators by wire field name.
  static const Map<String, String? Function(String?)> all = {
    'age': age,
    'code': code,
    'email': email,
    'name': name,
    'score': score,
  };
}

