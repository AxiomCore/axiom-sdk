<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug only: cleartext HTTP to the fixture backend at 10.0.2.2:8791
         (emulator) is allowed by res/xml/network_security_config.xml.
         Pass the URL as dart-define FIXTURE_BASE_URL (see axiom_flutter/android/README.md). -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="UnusedAttribute"/>
</manifest>
