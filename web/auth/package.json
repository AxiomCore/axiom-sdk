{
  "name": "@axiomcore/auth-web",
  "version": "0.1.0",
  "description": "Browser client for Axiom project authentication (auth-surfaces/v1).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "check": "node --disable-warning=ExperimentalWarning scripts/build.mjs --check",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\""
  }
}
